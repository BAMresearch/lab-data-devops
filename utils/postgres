# utils/postgres
# Generate a container unit for a postgres db
# USAGE:
#   $ . utils/postgres

genPostgresSvc()
{
    local cname="$1"
    local tag="$2"
    local dbpath="$3"
    local network="$4"
    shift 4
    # skip if this service is running already
    # to be stopped is explicitly, allows indempotent scripting
    systemctl --user is-active --quiet "$cname" && return

    mkdir -p "$dbpath"

    local secretname=${cname}-admin-pass
    genPodmanSecret $secretname

    local contpath="$HOME/.config/containers/systemd"
    mkdir -p "$contpath"

cat > "$contpath/$cname.container" << EOF
[Unit]
Description=Postgres DB
After=network-online.target

[Container]
User=postgres
ContainerName=$cname
Image=docker.io/library/postgres:$tag
Volume=$dbpath:/var/lib/postgresql/data:rw,Z
$(echo "$@" | sed -E 's/([[:space:]])([A-Z_][A-Z0-9_]*=)/\n\2/g' | sed '/^$/d; s/.*/Environment=&/')
Secret=$secretname,type=env,target=POSTGRES_PASSWORD
Network=$network

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
EOF
    chmod o-rwx "$contpath/$cname.container"
    # make the new container (or updates) know to systemctl
    systemctl --user daemon-reload
}


# utils/webserver
# Generate a container unit for a nginx webserver
# USAGE:
#   $ . utils/webserver

genWebServerSvc()
{
    local cname="$1"
    local staticpath="$2"
    local port="$3"
    local network="$4"
    local tag="$5"
    local nargs=5
    [ -z "$tag" ] && nargs=$((nargs-1))
    [ -z "$network" ] && nargs=$((nargs-1))
    shift "$nargs"
    # skip if this service is running already
    # to be stopped is explicitly, allows indempotent scripting
    systemctl --user is-active --quiet "$cname" && return

    [ -z "$tag" ] && tag=latest

    local contpath="$HOME/.config/containers/systemd"
    mkdir -p "$contpath"

cat > "$contpath/$cname.container" << EOF
[Unit]
Description=Nginx Web Server
After=network-online.target

[Container]
ContainerName=$cname
Image=docker.io/library/nginx:$tag
Volume=$staticpath:/usr/share/nginx/html:ro,Z
$(echo "$@" | sed -E 's/([[:space:]])([A-Z_][A-Z0-9_]*=)/\n\2/g' | sed '/^$/d; s/.*/Environment=&/')
$([ -z "$network" ] || echo "Network=$network")
PublishPort=$port:80

[Service]
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
EOF
    chmod o-rwx "$contpath/$cname.container"
    # make the new container (or updates) know to systemctl
    systemctl --user daemon-reload
}

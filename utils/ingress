# ingress
# setting up ingress rules of an existing k8s
# USAGE:
#   $ . ingress

k8sAccess() {
    cmdExists kubectl && kubectl get po -A >/dev/null 2>&1
}

setupIngress() {
    NS="$1"
    YAML_PATH="$2"
    PUBFILE="$3"
    KEYFILE="$4"
    FQDN="$5"
    SVC="$NS"
    SECRET_NAME="$NS.tls"
    k8sAccess || return
    namespaceExists "$NS" || kubectl create ns "$NS"
    createTLSsecret "$NS" "$SECRET_NAME" "$PUBFILE" "$KEYFILE"
    tmpfn="$(mktemp)"
    cp "$YAML_PATH" "$tmpfn"
    formatTextFile "$tmpfn" SVC FQDN SECRET_NAME DOMAINBASE
    cat "$tmpfn"
    # echo "$tmpfn" # for debugging
    kubectl apply -n "$NS" -f "$tmpfn" && rm -f "$tmpfn"
}

teardownIngress() {
    NS="$1"
    SECRET_NAME="$NS.tls"
    SERVICES="$2"
    k8sAccess || return
    kubectl delete secret -n "$NS" "$SECRET_NAME"
    kubectl delete service -n "$NS" $SERVICES
    kubectl delete ingress -n "$NS" "$NS-local-backend"
    kubectl delete ns "$NS"
    echo "done."
}
